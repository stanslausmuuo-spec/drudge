# LiveKit Cloud (wss://) — copy your real key/secret from the LiveKit dashboard into .env.local.
# The values below are placeholders; keep real credentials out of tracked files.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key_here
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# STT - Whisper (local, no API key needed)
WHISPER_URL=http://localhost:9000

# TTS - Piper (local, no API key needed)
PIPER_URL=http://localhost:5000

# Default Google Gemini API key (fallback for gemini-3-flash-preview when no user key is set)
# GOOGLE_API_KEY=your_gemini_api_key_here

# Optional: Anthropic (Claude) — required for claude-* models in the agent and /api/chat
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Optional: Mem0 (long-term memory) — if unset, Jarvis falls back to local JSON memory
# MEM0_API_KEY=your_mem0_api_key_here

# Optional: Deepgram (free $200 credit) - uncomment if you prefer cloud STT/TTS
# DEEPGRAM_API_KEY=your_deepgram_api_key_here

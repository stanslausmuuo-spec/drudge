# LiveKit Server (dev mode defaults - do not change for local development)
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# STT - Whisper (local, no API key needed)
WHISPER_URL=http://localhost:9000

# TTS - Piper (local, no API key needed)
PIPER_URL=http://localhost:5000

# Optional: Deepgram (free $200 credit) - uncomment if you prefer cloud STT/TTS
# DEEPGRAM_API_KEY=your_deepgram_api_key_here
